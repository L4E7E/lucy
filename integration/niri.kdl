// Lucy popup blur only; keep click-dismiss surfaces fully transparent.
gestures {
    hot-corners { off; }
}
// Keep the existing layout { struts { top 42; } } once; do not duplicate it.
// Replace the existing Waybar startup command with:
// spawn-at-startup "systemctl" "--user" "start" "lucy-bar.service"
// Remove the Mako startup entry when enabling Lucy notifications.
// Replace the existing swayidle startup with:
// spawn-at-startup "systemctl" "--user" "start" "lucy-idle.service"
// Inside the existing binds block:
// Ensure the installed lucy-shell is in the graphical session's PATH.
// Mod+S { spawn "lucy-shell" "control"; }
// Alt+Space { spawn "lucy-shell" "launcher"; }
// Mod+Ctrl+Return { spawn "lucy-shell" "launcher"; }
// Mod+Comma { spawn "lucy-shell" "control"; }
// Mod+Shift+Q { spawn "lucy-shell" "control" "--page" "session"; }
// Mod+Alt+L { spawn "lucy-shell" "lock" "--daemonize"; }
// XF86AudioRaiseVolume allow-when-locked=true { spawn "lucy-shell" "osd" "volume" "up"; }
// XF86AudioLowerVolume allow-when-locked=true { spawn "lucy-shell" "osd" "volume" "down"; }
// XF86AudioMute allow-when-locked=true { spawn "lucy-shell" "osd" "volume" "mute"; }
// XF86AudioMicMute allow-when-locked=true { spawn "lucy-shell" "osd" "microphone" "mute"; }
// XF86MonBrightnessUp allow-when-locked=true { spawn "lucy-shell" "osd" "brightness" "up"; }
// XF86MonBrightnessDown allow-when-locked=true { spawn "lucy-shell" "osd" "brightness" "down"; }
// ASUS Fn+F2/F3 is firmware-controlled. Lucy watches brightness_hw_changed
// directly; no XF86 binding is needed and brightness must not be adjusted twice.
// Control and calendar borrow their original right/center bar wl_surface.
// Keep Lucy corners at 20: GPU material and Niri blur masks resize together.
// Non-xray blur includes the windows underneath rather than only the wallpaper.
// Niri 26.04 has a cross-GPU non-xray blur bug; use a build containing the
// upstream Smithay fix. See https://github.com/niri-wm/niri/pull/4395.
// The modal session scrim covers all outputs with one shared pixel.
// It is translucent: non-xray compositor blur includes the live windows below.
layer-rule {
    match namespace="^lucy-session-backdrop$"
    geometry-corner-radius 0
    shadow { off; }
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^lucy-session-popup$"
    geometry-corner-radius 0
    shadow { off; }
    background-effect {
        blur false
        xray false
    }
}
layer-rule {
    match namespace="^lucy-bar-(left|center|right)$"
    geometry-corner-radius 20
    shadow { off; }
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^lucy-(audio|network|control|calendar|launcher|notification)-popup$"
    geometry-corner-radius 20
    shadow { off; }
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^lucy-(audio|network|control|calendar|launcher|expanded)-dismiss$"
    shadow { off; }
    background-effect {
        blur false
        xray false
    }
}
